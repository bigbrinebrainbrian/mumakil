# ==============================================================================
# Mumakil 2.0 Environment Configuration Template
# ==============================================================================

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Mumakil Security QC Token
QC_TOKEN=a1b2c3d4-e5f6-7890-abcd-ef1234567890

# Target Backend Settings (project_dbmigas)
TARGET_BASE_URL=http://localhost/project_dbmigas/index.php

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Performance & Concurrency Limits
REQUEST_TIMEOUT_SECONDS=15.0
AI_TIMEOUT_SECONDS=20.0
MAX_RETRIES=3
CONCURRENCY_LIMIT=20
CONNECTION_POOL_LIMITS_MAX=100
CONNECTION_POOL_LIMITS_KEEPALIVE=50

# Storage & Persistence
SQLITE_DB_PATH=storage/mumakil_state.db
LOG_DIR=storage/logs
